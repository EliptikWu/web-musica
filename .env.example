# Modo de la API (doc 03): "simulado" mientras no hay backend; "real" para hablar con él.
NEXT_PUBLIC_API_MODE=simulado
# Base de la API del backend, solo en modo real. La ve el servidor de Next, nunca el navegador.
ROCKOLA_API_URL=
# "1" solo si delante de la app hay un proxy de confianza que reescribe X-Forwarded-For
# (la plataforma de despliegue). Sin él, esas cabeceras no llegan al backend.
ROCKOLA_CONFIAR_PROXY=

# Cuenta inicial de la plataforma (RF-064). La lee el backend solo si no hay ninguna cuenta;
# obliga a cambiar la clave al entrar. Clave de al menos 12 caracteres.
ROCKOLA_SUPERADMIN_CORREO=
ROCKOLA_SUPERADMIN_CLAVE=

# Pipeline analítico (rokolaBackend/pipeline/README.md). No los usa la web.
ANALITICA_JDBC_URL=
# Clave HMAC del seudónimo del teléfono, de al menos 32 caracteres. Se guarda fuera de la base.
ROCKOLA_SEUDONIMO_CLAVE=
