# Modo de la API (doc 03): "simulado" mientras no hay backend; "real" para hablar con él.
NEXT_PUBLIC_API_MODE=simulado
# Base de la API del backend, solo en modo real. La ve el servidor de Next, nunca el navegador.
ROCKOLA_API_URL=
# "1" solo si delante de la app hay un proxy de confianza que reescribe X-Forwarded-For
# (la plataforma de despliegue). Sin él, esas cabeceras no llegan al backend.
ROCKOLA_CONFIAR_PROXY=
