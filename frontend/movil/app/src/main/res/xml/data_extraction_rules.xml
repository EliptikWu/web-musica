<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 o más. El identificador del teléfono no se copia a otro aparato (AlmacenTelefono). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="rockola-telefono.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="rockola-telefono.xml" />
    </device-transfer>
</data-extraction-rules>
